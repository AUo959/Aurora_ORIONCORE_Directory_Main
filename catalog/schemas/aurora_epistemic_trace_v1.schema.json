{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora.local/schemas/aurora_epistemic_trace_v1.schema.json",
  "title": "Aurora Epistemic Trace v1",
  "description": "Replayable belief, dissent, echo, forecast, and confidence trace linked to an ASM episode.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "aurora_epistemic_trace"},
    "trace_id": {
      "type": "string",
      "pattern": "^asm\\.trace\\.[A-Za-z0-9_.:-]+$"
    },
    "episode_id": {
      "type": "string",
      "pattern": "^asm\\.episode\\.[A-Za-z0-9_.:-]+$"
    },
    "authority": {
      "enum": ["simulation", "evaluation", "synthetic_fixture"]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "component": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "repository_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{7,40}$"
        },
        "seed": {"type": "integer", "minimum": 0}
      },
      "required": [
        "component",
        "version",
        "repository_revision",
        "seed"
      ]
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "topology": {"type": "string", "minLength": 1},
        "agent_count": {"type": "integer", "minimum": 1},
        "cell_size": {"type": "integer", "minimum": 1}
      },
      "required": [
        "network_hash",
        "topology",
        "agent_count",
        "cell_size"
      ]
    },
    "observation_mask": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mask_id": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "hidden_state_paths": {
          "type": "array",
          "items": {"type": "string", "pattern": "^/"}
        }
      },
      "required": ["mask_id", "evidence_refs", "hidden_state_paths"]
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "granularity": {
          "enum": ["aggregate_only", "agent_level", "hybrid"]
        },
        "agent_level_shard_ref": {"type": "string", "minLength": 1}
      },
      "required": ["granularity"]
    },
    "snapshots": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "round": {"type": "integer", "minimum": 0},
          "aggregate_beliefs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "group_id": {"type": "string", "minLength": 1},
                "member_count": {"type": "integer", "minimum": 1},
                "belief_mean": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "belief_variance": {"type": "number", "minimum": 0},
                "confidence_mean": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "group_id",
                "member_count",
                "belief_mean",
                "belief_variance",
                "confidence_mean"
              ]
            }
          }
        },
        "required": ["round", "aggregate_beliefs"]
      }
    },
    "dynamics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dissent_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "echo_risk": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "polarization_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": ["dissent_score", "echo_risk", "polarization_score"]
    },
    "forecast": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outcomes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {"type": "string", "minLength": 1},
              "probability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": ["label", "probability"]
          }
        },
        "confidence_components": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "required": ["outcomes", "confidence_components"]
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_valid": {"type": "boolean"},
        "replay_classification": {
          "enum": [
            "byte_stable",
            "structurally_stable",
            "nondeterministic",
            "not_run"
          ]
        },
        "validator_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "required": [
        "schema_valid",
        "replay_classification",
        "validator_refs"
      ]
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eligible": {"const": false},
        "reason": {"type": "string", "minLength": 1}
      },
      "required": ["eligible", "reason"]
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "trace_id",
    "episode_id",
    "authority",
    "created_at",
    "producer",
    "network",
    "observation_mask",
    "storage",
    "snapshots",
    "dynamics",
    "forecast",
    "validation",
    "promotion"
  ]
}
