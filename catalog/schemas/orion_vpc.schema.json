{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora.local/schemas/orion_vpc.schema.json",
  "title": "ORION Project Space VPC Registry",
  "description": "Cross-platform process registry for bounded Validated Project Conclusions. Process status is distinct from target authority.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "registry_id": {"const": "ORION.PROJECTSPACE.VPC.REGISTRY"},
    "authority_role": {"const": "cross_platform_process_registry"},
    "authority_boundary": {"const": "records_target_authority_without_conferring_canon_or_implementation"},
    "source_documents": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/vpc_record"}}
  },
  "required": ["schema_version", "registry_id", "authority_role", "authority_boundary", "source_documents", "records"],
  "$defs": {
    "string_list": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "nullable_string": {"type": ["string", "null"]},
    "vpc_record": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^ORION\\.VPC\\.[A-Z0-9_]+\\.[0-9]{4}$"},
        "title": {"type": "string", "minLength": 1},
        "type": {"type": "string", "enum": ["OBSERVATION", "PROPOSAL", "DECISION", "CANON_ASSERTION", "IMPLEMENTATION_TASK", "GOVERNANCE_MUTATION", "DOC_CORRECTION", "RESEARCH_QUESTION"]},
        "status": {"type": "string", "enum": ["CAPTURED", "CLASSIFIED", "EVIDENCE_BOUND", "CONFLICT_REVIEW", "TARGETED", "PACKAGED", "ACCEPTED", "PROMOTED", "SUPERSEDED", "BLOCKED", "REJECTED"]},
        "statement": {"type": "string", "minLength": 1},
        "authority_class": {"type": "string", "enum": ["PROJECT_SPACE_WORKING", "ACCEPTED_ARCHITECTURE", "CANON", "IMPLEMENTED"]},
        "layers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["L1", "L2", "L3"]}},
        "source_pointers": {"$ref": "#/$defs/string_list"},
        "affected_surfaces": {"$ref": "#/$defs/string_list"},
        "dependencies": {"$ref": "#/$defs/string_list"},
        "conflicts": {"$ref": "#/$defs/string_list"},
        "assumptions": {"$ref": "#/$defs/string_list"},
        "unknowns": {"$ref": "#/$defs/string_list"},
        "acceptance_criteria": {"$ref": "#/$defs/string_list"},
        "promotion_target": {"$ref": "#/$defs/nullable_string"},
        "promotion_evidence": {"$ref": "#/$defs/nullable_string"},
        "supersedes": {"$ref": "#/$defs/string_list"},
        "superseded_by": {"$ref": "#/$defs/nullable_string"},
        "owner": {"$ref": "#/$defs/nullable_string"}
      },
      "required": ["id", "title", "type", "status", "statement", "authority_class", "layers", "source_pointers", "affected_surfaces", "dependencies", "conflicts", "assumptions", "unknowns", "acceptance_criteria", "promotion_target", "promotion_evidence", "supersedes", "superseded_by", "owner"],
      "allOf": [
        {"if": {"properties": {"status": {"const": "PROMOTED"}}, "required": ["status"]}, "then": {"properties": {"promotion_target": {"type": "string", "minLength": 1}, "promotion_evidence": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1}}}},
        {"if": {"properties": {"status": {"const": "SUPERSEDED"}}, "required": ["status"]}, "then": {"properties": {"superseded_by": {"type": "string", "minLength": 1}}}}
      ]
    }
  }
}
