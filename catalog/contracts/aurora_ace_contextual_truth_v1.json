{
  "schema_version": "1.0.0",
  "record_type": "ace_contextual_truth_contract",
  "policy_ref": "catalog/ace/policies/contextual_truth_v1.json",
  "authority_source": "persisted_operator_assignment",
  "governing_layer": "L3",
  "governed_layers": ["L1", "L2"],
  "operator_context_is_runtime_activation": false,
  "L1_route": "existing_ACE_read_only_canon_fact_resolver",
  "L2_route": "existing_ACE_character_compiler_resolver_preview_token_native_commit",
  "invocation_mode": "autonomic",
  "queue_root": "<world>/state/contexts",
  "assignment_binding": ["world_id", "purpose", "target_layer", "settings", "policy_digest", "authority_ref", "max_jobs"],
  "need_binding": ["assignment_digest", "need_id", "question", "context"],
  "job_states": ["queued", "running", "complete", "blocked", "conflict"],
  "routine_success_requires_notification": false,
  "needs_attention_states": ["blocked", "conflict"],
  "MCP_tools": ["aurora_context_status", "aurora_simulation_need", "aurora_need_inspect"],
  "MCP_assignment_grant_allowed": false,
  "worker_lifetime": "stdio_server_lifetime",
  "disconnected_queue": "durable_until_next_worker_start",
  "cross_layer_promotion_authorized": false,
  "canonical_workspace_mutation_authorized": false,
  "publication_authorized": false,
  "orion_progression_authorized": false,
  "settings_boundary": "faction_and_location_type_scoped_per_world; role_permissions_scoped_per_assignment",
  "unsupported_settings": ["arbitrary_physics", "arbitrary_geometry", "L3_rule_mutation"],
  "recovery": "same_need_reuses_existing_world_transaction; journaled_native_commit_reconciles_before_queue_replay"
}
